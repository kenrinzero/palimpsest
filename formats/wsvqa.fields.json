{
  "sample": "samples/_staged/wsvqa/small-cut-v3.vqa",
  "independence": "third-party",
  "fields": [
    { "name": "width", "kaitai_path": "width", "ffprobe_path": ".streams[0].width", "kind": "numeric" },
    { "name": "height", "kaitai_path": "height", "ffprobe_path": ".streams[0].height", "kind": "numeric" },
    { "name": "frames", "kaitai_path": "num_frames", "ffprobe_path": ".streams[0].nb_frames", "kind": "numeric" },
    { "name": "finf_entries", "kaitai_path": "finf_entry_count", "ffprobe_path": ".streams[0].nb_frames", "kind": "numeric" },
    { "name": "frame_rate", "kaitai_path": "frame_rate", "ffprobe_path": "(.streams[0].r_frame_rate | split(\"/\") | .[0])", "kind": "numeric" },
    { "name": "sample_rate", "kaitai_path": "sample_rate", "ffprobe_path": "(.streams[] | select(.codec_type == \"audio\") | .sample_rate)", "kind": "numeric" },
    { "name": "channels", "kaitai_path": "channels", "ffprobe_path": "(.streams[] | select(.codec_type == \"audio\") | .channels)", "kind": "numeric" },
    { "name": "video_codec", "kaitai_path": "codec_label", "ffprobe_path": ".streams[0].codec_name", "kind": "label" },
    { "name": "audio_codec", "kaitai_path": "audio_codec_label", "ffprobe_path": ".streams[1].codec_name", "kind": "label" }
  ],
  "self_checked": ["declared-count == walked-count"]
}
